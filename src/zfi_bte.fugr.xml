      <TDSPRAS>D</TDSPRAS>
      <TDFORM>S_DOCU_SHOW</TDFORM>
      <TDSTYLE>S_DOCUS1</TDSTYLE>
      <TDVERSION>00012</TDVERSION>
      <TDLINESIZE>072</TDLINESIZE>
     </HEAD>
     <LINES>
      <TLINE>
       <TDFORMAT>/:</TDFORMAT>
       <TDLINE>DEFINE &amp;TEXT&amp;  = &apos;Zahlungsverkehr: Ausgabe von Avisen (Druckparameter)&apos;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>/:</TDFORMAT>
       <TDLINE>DEFINE &amp;EVENT&amp; = &apos;00002050&apos;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>/:</TDFORMAT>
       <TDLINE>DEFINE &amp;TYPE&amp;  = &apos;PROCESS&apos;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>/:</TDFORMAT>
       <TDLINE>INCLUDE FI_OPEN_FI_DOCUMENTATION_1 OBJECT DOKU ID TX</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>Prozess</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Der Prozess erlaubt die Ermittlung der für das Zahlungsavis zu</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>verwendende Druckparameter (Struktur ITCPO) sowie die Parameter zur</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>optischen Archivierung der Avise, sofern dies gewünscht ist.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>Schnittstelle</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Auf Basis der übergebenen Regulierungsdaten (I_REGUH), den ggf. im</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Prozess 00002040 geänderten Daten (Nachrichtenart und Formular) und den</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>vorgeschlagenen Druckparametern können die Parameter zum Druck des</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Avises modifiziert und die Archivierungsparameter gesetzt werden.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;EXAMPLE&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Der Funktionsbaustein</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>&lt;DS:FU.FI_OPT_ARCHIVE_PAYMENT_ADVICE&gt;FI_OPT_ARCHIVE_PAYMENT_ADVICE&lt;/&gt;</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>kann als Vorlage für ein ablauffähiges Beispiel für die optische</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Archivierung von Avisen verwendet werden.</TDLINE>
      </TLINE>
     </LINES>
    </item>
    <item>
